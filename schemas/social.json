{
  "node_types": [
    {
      "name": "User",
      "file": "nodes_User.parquet",
      "primary_key": "nodeId",
      "properties": {
        "name": "string",
        "status": "string",
        "language": "string",
        "joined": "date",
        "posts": "integer",
        "sessions": "integer",
        "spent": "double",
        "banned": "boolean"
      }
    },
    {
      "name": "Device",
      "file": "nodes_Device.parquet",
      "primary_key": "nodeId",
      "properties": {
        "name": "string",
        "os": "string",
        "firstSeen": "date",
        "sessions": "integer"
      }
    },
    {
      "name": "Location",
      "file": "nodes_Location.parquet",
      "primary_key": "nodeId",
      "properties": {
        "name": "string"
      }
    }
  ],
  "link_types": [
    {
      "name": "FOLLOWS",
      "from_type": "User",
      "to_type": "User",
      "backing": {
        "dataset": {
          "file": "edges_FOLLOWS__User__User.parquet",
          "a": "src",
          "b": "dst"
        }
      }
    },
    {
      "name": "USES",
      "from_type": "User",
      "to_type": "Device",
      "backing": {
        "dataset": {
          "file": "edges_USES__User__Device.parquet",
          "a": "src",
          "b": "dst"
        }
      }
    },
    {
      "name": "SEEN_AT",
      "from_type": "Device",
      "to_type": "Location",
      "backing": {
        "dataset": {
          "file": "edges_SEEN_AT__Device__Location.parquet",
          "a": "src",
          "b": "dst"
        }
      }
    },
    {
      "name": "LIVES_IN",
      "from_type": "User",
      "to_type": "Location",
      "backing": {
        "dataset": {
          "file": "edges_LIVES_IN__User__Location.parquet",
          "a": "src",
          "b": "dst"
        }
      }
    }
  ]
}
